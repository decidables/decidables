{
  "name": "decidables",
  "description": "Monorepo for decidables: Explorable Explanations of Decision Making",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/decidables/decidables.git"
  },
  "bugs": "https://github.com/decidables/decidables/issues",
  "homepage": "https://github.com/decidables/decidables",
  "author": "Adam Krawitz (https://web.uvic.ca/psyc/krawitz/)",
  "license": "CC-BY-SA-4.0 AND GPL-3.0-or-later",
  "private": true,
  "scripts": {
    "postinstall": "husky",
    "clean": "yarn workspaces foreach -Apitv -j 2 run clean",
    "lint": "yarn gulp lint && yarn workspaces foreach -Apitv -j 2 run lint",
    "test": "yarn workspaces foreach -Atv run test",
    "develop": "yarn workspaces foreach -Apitv -j 2 run develop",
    "build": "yarn workspaces foreach -Apitv -j 2 run build",
    "changed": "lerna changed -a",
    "versions": "lerna version --conventional-commits --create-release github",
    "publish": "lerna publish from-git --no-private",
    "deploy": "yarn workspaces foreach -Apitv -j 2 run deploy",
    "serve": "gulp serveAll",
    "libraries": "yarn workspaces foreach -Apitv -j 2 --include \"libraries/*\" \"$@\"",
    "sites": "yarn workspaces foreach -Apitv -j 2 --include \"sites/*\" \"$@\"",
    "all": "yarn workspaces foreach -Apitv -j 2 -n \"$@\""
  },
  "workspaces": [
    "libraries/*",
    "sites/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "yarn@4.12.0",
  "browserslist": [
    "baseline widely available with downstream"
  ],
  "resolutions": {
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@citation-js/core": "^0.7.21",
    "@citation-js/plugin-bibtex": "^0.7.21",
    "@citation-js/plugin-csl": "^0.7.22",
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@eslint/js": "^10.0.1",
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "@open-wc/testing": "^4.0.0",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-yaml": "^4.1.2",
    "@stylistic/stylelint-plugin": "^5.2.0",
    "@web/dev-server-rollup": "^0.6.4",
    "@web/test-runner": "^0.20.2",
    "@web/test-runner-commands": "^0.9.0",
    "babel-plugin-polyfill-corejs3": "^1.0.0",
    "camelcase": "^9.0.0",
    "citeproc": "^2.4.63",

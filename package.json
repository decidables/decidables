{
  "name": "decidables",
  "description": "Monorepo for decidables: Explorable Explanations of Decision Making",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/decidables/decidables.git"
  },
  "bugs": "https://github.com/decidables/decidables/issues",
  "homepage": "https://github.com/decidables/decidables",
  "author": "Adam Krawitz (https://web.uvic.ca/psyc/krawitz/)",
  "license": "CC-BY-SA-4.0 AND GPL-3.0-or-later",
  "private": true,
  "scripts": {
    "postinstall": "husky",
    "lint": "yarn gulp lint && yarn workspaces foreach -Apitv -j 2 run lint",
    "test": "yarn workspaces foreach -Atv run test",
    "compile": "yarn workspaces foreach -Apitv -j 2 run compile",
    "watch": "yarn workspaces foreach -Apitv -j 2 run watch",
    "build": "yarn workspaces foreach -Apitv -j 2 run build",
    "changed": "lerna changed -a",
    "versions": "lerna version --conventional-commits --create-release github",
    "publish": "lerna publish from-git --no-private",
    "deploy": "yarn workspaces foreach -Apitv -j 2 run deploy",
    "serve": "gulp serveAll"
  },
  "workspaces": [
    "libraries/*",
    "sites/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "yarn@4.11.0",
  "browserslist": [
    "baseline widely available with downstream"
  ],
  "resolutions": {
    "sharp": "0.34.4"
  },

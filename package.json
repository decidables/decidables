    "stylelint": "^17.13.0",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-sass-guidelines": "^13.0.0",
    "stylelint-formatter-pretty": "^4.0.1",
    "stylelint-order": "^8.1.1",
    "stylelint-scss": "^7.2.0",
    "svgo": "^4.0.1",
    "type-detect": "^4.1.0",
    "unified": "^11.0.5",

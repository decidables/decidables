    "eslint-formatter-pretty": "^7.1.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "express": "^5.2.1",
    "fancy-log": "^2.0.0",
    "favicons": "7.3.0",
    "front-matter": "^4.0.2",
    "globals": "^17.7.0",
    "globby": "^16.2.0",
    "gulp": "^5.0.1",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "hastscript": "^9.0.1",
    "html-minifier": "^4.0.0",
    "htmlhint": "^1.9.2",
    "husky": "^9.1.7",
    "js-yaml": "^5.1.0",
    "lerna": "^9.0.7",
    "mdast-util-to-string": "^4.0.0",
    "node-notifier": "^10.0.1",
    "node-sass-yaml-importer": "9.0.1",
    "postcss": "^8.5.15",
    "postcss-lit": "^1.4.1",
    "postcss-syntax": "^0.36.2",
    "rehype-autolink-headings": "^7.1.0",
